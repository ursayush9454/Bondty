# Apache only (ignored by Netlify/Vercel/GitHub Pages)
ErrorDocument 404 /404.html
Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 0. Old privacy URL -> /privacy-policy/ (301)
RewriteRule ^privacy(/|\.html)?$ /privacy-policy/ [L,R=301]

# 2. /index.html (and /hi/index.html etc.) -> folder URL, 301
RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]

# 3. Old .html URLs -> folder-style clean URLs, 301 (Search Console verification file and 404 page stay as they are)
RewriteCond %{REQUEST_URI} !^/google8059152972c3b4d0\.html$
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteCond %{THE_REQUEST} \s/(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1/ [L,R=301]

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/html "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
